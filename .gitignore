```gitignore
# ============================================================
# ForensIQ - Git Ignore
# ============================================================

# -------------------------
# Node / React / Vite
# -------------------------
node_modules/
dist/
build/
.vite/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -------------------------
# Environment / Secrets
# -------------------------
.env
.env.*
!.env.example
!.env.*.example

# -------------------------
# Python
# -------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# -------------------------
# IDE / Editor
# -------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# -------------------------
# OS files
# -------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ============================================================
# ML DATASETS - DO NOT COMMIT
# ============================================================
ForensIQ-ML/dataset/
ForensIQ-ML/datasets/
ForensIQ-ML/synthetic_dataset/
**/dataset/
**/datasets/
**/synthetic_dataset/

# ============================================================
# MODEL CHECKPOINTS - DO NOT COMMIT
# ============================================================
ForensIQ-ML/checkpoints/
**/checkpoints/
*.pth
*.pt
*.ckpt
*.onnx

# ============================================================
# DEBUG CROPS / GENERATED VISUALIZATIONS
# ============================================================
ForensIQ-ML/debug_crops/
ForensIQ-ML/gradcam_results/
ForensIQ-ML/ensemble_results/
ForensIQ-ML/experiment_results/
ForensIQ-ML/results/

# ============================================================
# GENERATED PREDICTION / EXPERIMENT OUTPUTS
# ============================================================
ForensIQ-ML/predictions/
ForensIQ-ML/prediction_results/
ForensIQ-ML/v2_results/
ForensIQ-ML/inference/result.json

# Temporary prediction outputs
**/debug_crops/
*.tmp
*.temp
*.bak
*.cache

# Python serialized data
*.pickle
*.pkl

# Jupyter
.ipynb_checkpoints/

# Local testing images
test*.jpg
test*.jpeg
test*.png
test*.webp
```
