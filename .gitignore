# ============================================================
# ForensIQ - Git Ignore
# ============================================================

# -------------------------
# Node / React / Vite
# -------------------------
node_modules/
dist/
build/
.vite/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -------------------------
# Environment / Secrets
# -------------------------
.env
.env.local
.env.*.local
!.env.example

# -------------------------
# Python
# -------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# -------------------------
# IDE / Editor
# -------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ============================================================
# FORENSIQ - DO NOT COMMIT LARGE/GENERATED DATA
# ============================================================

# -------------------------
# Training datasets
# -------------------------
ForensIQ-ML/dataset/
ForensIQ-ML/synthetic_dataset/

# If datasets exist elsewhere:
**/dataset/
**/datasets/
**/synthetic_dataset/

# -------------------------
# Generated prediction results
# -------------------------
ForensIQ-ML/predictions/
ForensIQ-ML/prediction_results/
ForensIQ-ML/v2_results/

# CSV/JSON results generated during experiments
ForensIQ-ML/v2_results/*.csv
ForensIQ-ML/v2_results/*.json

# -------------------------
# Grad-CAM generated outputs
# -------------------------
ForensIQ-ML/gradcam_results/
ForensIQ-ML/gradcam_results/*.jpg
ForensIQ-ML/gradcam_results/*.jpeg
ForensIQ-ML/gradcam_results/*.png
ForensIQ-ML/gradcam_results/*.npy
ForensIQ-ML/gradcam_results/*.json

# -------------------------
# Experiment outputs
# -------------------------
ForensIQ-ML/ensemble_results/
ForensIQ-ML/experiment_results/
ForensIQ-ML/results/

# ============================================================
# IMPORTANT:
# DO NOT IGNORE MODEL CHECKPOINTS
# ============================================================

# Keep these tracked in Git:
# *.pth
# *.pt
#
# Your trained Xception / EfficientNet-B4 checkpoints
# must remain available to every team member.

# ============================================================
# Temporary / local files
# ============================================================

*.tmp
*.temp
*.bak
*.cache

# Python generated files
*.pickle
*.pkl

# Jupyter
.ipynb_checkpoints/

# -------------------------
# OS files
# -------------------------
.DS_Store
ehthumbs.db
Desktop.ini

# Local testing images
test*.jpg
test*.jpeg
test*.png
test*.webp

# Or, if ALL images in the project root are just temporary tests:
# /test*.*